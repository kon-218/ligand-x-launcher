# ============================================================
# Ligand-X Production Environment Configuration
# ============================================================
# Copy this file to .env.production and fill in the values.
# Load it with: docker-compose --env-file .env.production up -d
#
# SECURITY: Never commit .env.production to version control!
# Add .env.production to .gitignore
# ============================================================

# ============================================================
# Image Version
# ============================================================
# REQUIRED: Pin app images to an immutable release (tag or digest alias).
# Examples: VERSION=v0.9.4 or VERSION=sha-abc1234
# Do not use mutable 'latest' in production.
VERSION=v2026.08.05
# Pro images are published on their own cadence. v2026.08.05 is a core-only
# release, so Pro stays on the last tag it was actually built at — without this
# a licensed install would try to pull Pro images that were never pushed.
# Unset means "follow VERSION".
PRO_VERSION=v2026.06.21
LIGANDX_PRO_IMAGE_PREFIX=ghcr.io/kon-218/ligand-x-pro

# The gpu-short worker is shared: md_optimize and workflow_run are free, while
# admet_predict, boltz_predict, boltz_batch and rbfe_mapping_preview are Pro.
# Unset (the default) runs the public worker image, which serves the free pair
# and needs no registry credentials -- so a free-tier install can run MD without
# a licence. The launcher sets this to the Pro superset image whenever a Pro
# group that uses gpu-short is selected, and clears it again when none is.
# It is a whole image reference, not a prefix: VERSION and PRO_VERSION are
# pinned separately, so substituting only the registry can pair a Pro tag with
# the public repository and fail with "manifest unknown".
# LIGANDX_GPU_SHORT_IMAGE=

# ============================================================
# Pro Licensing / Private Image Access
# ============================================================
# Production Pro pulls should use a vendor token broker that returns short-lived,
# repository-scoped pull credentials. The launcher sends the token in
# LIGANDX_VENDOR_ACCESS_TOKEN to this endpoint when pulling private images.
LIGANDX_REGISTRY_TOKEN_URL=
LIGANDX_VENDOR_ACCESS_TOKEN=

# Optional supply-chain enforcement for launcher pulls. When true, the launcher
# requires cosign to be installed and verifies each image before pulling.
LIGANDX_REQUIRE_IMAGE_SIGNATURES=false
LIGANDX_COSIGN_KEY=
LIGANDX_COSIGN_CERT_IDENTITY=
LIGANDX_COSIGN_OIDC_ISSUER=

# ============================================================
# Database Configuration
# ============================================================
# REQUIRED: All three variables below must be set before starting.
# The application will not start without them.
POSTGRES_USER=ligandx
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
POSTGRES_DB=ligandx
DATABASE_URL=postgresql://ligandx:CHANGE_ME_SECURE_PASSWORD_HERE@postgres:5432/ligandx

# ============================================================
# Message Queue Configuration
# ============================================================
# REQUIRED: RABBITMQ_USER and RABBITMQ_PASSWORD must be set before starting.
RABBITMQ_USER=ligandx
RABBITMQ_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
CELERY_BROKER_URL=amqp://ligandx:CHANGE_ME_SECURE_PASSWORD_HERE@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_SECURE_PASSWORD_HERE@redis:6379/0

# ============================================================
# Redis Configuration
# ============================================================
# REQUIRED: REDIS_PASSWORD must be set before starting.
REDIS_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
REDIS_URL=redis://:CHANGE_ME_SECURE_PASSWORD_HERE@redis:6379/0

# ============================================================
# Application Environment
# ============================================================
# Set to 'production' for production deployments
# Controls queue durability and other development-specific behaviors
APP_ENV=production
LIGANDX_DEPLOYMENT_MODE=single_user
LIGANDX_ENABLE_PREVIEW_MODULES=false
LIGANDX_ENABLE_EXPERIMENTAL_MODULES=false
LIGANDX_ENABLE_CHECKPOINT_PAUSE=false
# Developer preview requires both LIGANDX_ENABLE_PREVIEW_MODULES=true and: docker compose --profile preview up.

# ============================================================
# Application Secrets
# ============================================================
# You can generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
QC_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_KEY_HERE

# Expiring, revocable browser sessions are issued after password login.
LIGANDX_SESSION_LIFETIME_HOURS=12
LIGANDX_SESSION_IDLE_MINUTES=30
LIGANDX_REQUEST_BODY_TIMEOUT_SECONDS=30

# Shared secret workers use to authenticate internal job-status callbacks to the
# gateway. REQUIRED: if unset, docking and other worker status updates are rejected
# and jobs appear permanently stuck. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_WORKER_SECRET=CHANGE_ME_GENERATE_RANDOM_KEY_HERE

# Login credentials for the web UI
LIGANDX_USERNAME=admin
LIGANDX_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

# ============================================================
# Celery Worker Concurrency
# ============================================================
# Adjust based on your hardware resources
QC_WORKER_CONCURRENCY=2
GPU_SHORT_CONCURRENCY=2
GPU_LONG_CONCURRENCY=1
CPU_WORKER_CONCURRENCY=2

# ============================================================
# External Service Configuration
# ============================================================
# Ligand-X integrates with two scientific engines it does not redistribute,
# because their licences do not permit redistribution. Install them yourself,
# under your own licence, and point these paths at them.
#
# ORCA quantum chemistry binary path (host path mounted into containers)
# You can find the path to the ORCA executable on your system with: which orca
ORCA_HOST_PATH=/opt/orca
# NAMD, used only for kinetics pre-seeding. Optional — leave this as-is and the
# kinetics module uses RAMD pre-seeding instead, which needs nothing external.
# NAMD is free for academic, research and internal business use under the
# University of Illinois licence; commercial use requires a licence from
# Illinois. Download: http://www.ks.uiuc.edu/Research/namd/
NAMD_HOST_PATH=/opt/namd

# ABFE service URL for testing
ABFE_API_URL=http://abfe:8010

# Boltz-2 MSA credentials (optional)
BOLTZ_MSA_USERNAME=
BOLTZ_MSA_PASSWORD=
MSA_API_KEY_VALUE=
API_KEY_HEADER=X-API-Key

# ============================================================
# Service Ports
# ============================================================
# WESTPA / RAMD kinetics microservice (gateway proxies /api/kinetics/*)
KINETICS_PORT=8014
KINETICS_URL=http://kinetics:8014

# Host ports the stack publishes. If one is already in use the launcher moves it
# to the next free port at start and rewrites the value here — CORS_ORIGINS and
# the launcher's Open buttons follow APP_PORT/GATEWAY_PORT automatically, so a
# moved port needs no further edits. APP_PORT (8080) is the app's single entry.
GATEWAY_PORT=8000
FRONTEND_PORT=3000
APP_PORT=8080
RABBITMQ_MGMT_PORT=15672
FLOWER_PORT=5555

# ============================================================
# Flower Monitoring Dashboard
# ============================================================
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

# ============================================================
# Frontend Configuration
# ============================================================
NEXT_PUBLIC_API_URL=
NODE_ENV=production

# ============================================================
# CORS Configuration
# ============================================================
# Comma-separated list of allowed origins for the API gateway.
# Same-origin via the proxy. List the proxy origin(s) the browser will use.
CORS_ORIGINS=http://localhost:8080,https://lab.k-nom.com

# ============================================================
# WebSocket Configuration
# ============================================================
# Maximum concurrent WebSocket connections. New connections over this limit
# are rejected with close code 1013 (Try Again Later).
WS_MAX_CONNECTIONS=500

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# Docker User (for host-mounted volumes)
# ============================================================
# Set automatically by `make dev`
# For production, set to the user that should own output files
UID=1000
GID=1000

# ============================================================
# Resource Limits
# ============================================================
# CPU/memory limits and reservations for every service.
# Tune these to match your hardware without touching docker-compose.yml.
#
# Format:
#   *_CPU_LIMIT  — max CPU cores the container may use (fractional ok: 0.5)
#   *_MEM_LIMIT  — max RAM (e.g. 4G, 512M)
#   *_CPU_RES    — guaranteed/reserved CPU cores
#   *_MEM_RES    — guaranteed/reserved RAM
#
# The CPU defaults below are deliberately CONSERVATIVE: every *_CPU_LIMIT is
# valid on a 4-thread machine, so a fresh install starts anywhere without any
# fix-up. Docker refuses to create a container whose *_CPU_LIMIT exceeds the
# number of CPUs the Docker daemon has ("range of CPUs is from 0.01 to 8.00"),
# which is a hard start failure — not a slow container — so the shipped values
# must never assume more hardware than the smallest supported machine has.
# They match the ${...:-4} fallbacks in docker-compose.yml.
#
# On every start the launcher also fits these to the machine it is running on
# and writes the result to .env.production. Fitting only ever LOWERS a value, so
# it will not raise these defaults on a big machine, and anything you set by
# hand below the machine's capacity is preserved.
#
# To scale up on a workstation, raise the worker limits — they dominate usage —
# and the matching Celery pool size, e.g. on 32 cores with ~128 GB RAM:
#   WORKER_CPU_CPU_LIMIT=16    CPU_WORKER_CONCURRENCY=4
#   WORKER_GPU_LONG_CPU_LIMIT=12
#   WORKER_GPU_SHORT_CPU_LIMIT=8
#   WORKER_QC_CPU_LIMIT=8      QC_WORKER_CONCURRENCY=2
# Edit the value in place — do not add a second line for a key that is already
# defined below. Compose resolves the LAST definition of a key, so an override
# inserted above the original silently does nothing.
# ============================================================

# --- API Gateway ---
GATEWAY_CPU_LIMIT=2
GATEWAY_MEM_LIMIT=2G
GATEWAY_CPU_RES=0.5
GATEWAY_MEM_RES=512M

# --- Frontend ---
FRONTEND_CPU_LIMIT=2
FRONTEND_MEM_LIMIT=4G
FRONTEND_CPU_RES=0.5
FRONTEND_MEM_RES=1G

# --- Lightweight Services (base conda env ~1.5 GB) ---
STRUCTURE_CPU_LIMIT=2
STRUCTURE_MEM_LIMIT=4G
STRUCTURE_CPU_RES=0.5
STRUCTURE_MEM_RES=1G

ALIGNMENT_CPU_LIMIT=1
ALIGNMENT_MEM_LIMIT=2G
ALIGNMENT_CPU_RES=0.25
ALIGNMENT_MEM_RES=512M

KETCHER_CPU_LIMIT=1
KETCHER_MEM_LIMIT=2G
KETCHER_CPU_RES=0.25
KETCHER_MEM_RES=512M

MSA_CPU_LIMIT=2
MSA_MEM_LIMIT=4G
MSA_CPU_RES=0.5
MSA_MEM_RES=1G

# --- Docking Service (~2.5 GB) ---
DOCKING_CPU_LIMIT=4
DOCKING_MEM_LIMIT=8G
DOCKING_CPU_RES=1
DOCKING_MEM_RES=2G

# --- ADMET Service (~3 GB, PyTorch CPU) ---
ADMET_CPU_LIMIT=2
ADMET_MEM_LIMIT=8G
ADMET_CPU_RES=0.5
ADMET_MEM_RES=2G

# --- QC Service (~2.5 GB, ORCA) ---
QC_CPU_LIMIT=4
QC_MEM_LIMIT=8G
QC_CPU_RES=1
QC_MEM_RES=2G

# --- GPU Services (MD env ~4 GB; require NVIDIA runtime) ---
MD_CPU_LIMIT=4
MD_MEM_LIMIT=16G
MD_CPU_RES=2
MD_MEM_RES=4G

ABFE_CPU_LIMIT=4
ABFE_MEM_LIMIT=16G
ABFE_CPU_RES=2
ABFE_MEM_RES=4G

RBFE_CPU_LIMIT=4
RBFE_MEM_LIMIT=16G
RBFE_CPU_RES=2
RBFE_MEM_RES=4G

BOLTZ2_CPU_LIMIT=4
BOLTZ2_MEM_LIMIT=16G
BOLTZ2_CPU_RES=2
BOLTZ2_MEM_RES=6G

# --- Celery Workers ---
# worker-qc: runs ORCA QC jobs (CPU-bound, potentially many cores per job)
WORKER_QC_CPU_LIMIT=4
WORKER_QC_MEM_LIMIT=16G
WORKER_QC_CPU_RES=1
WORKER_QC_MEM_RES=4G

# worker-gpu-short: MD, Boltz-2, ADMET tasks (fast, can run 2 concurrently)
WORKER_GPU_SHORT_CPU_LIMIT=4
WORKER_GPU_SHORT_MEM_LIMIT=32G
WORKER_GPU_SHORT_CPU_RES=1
WORKER_GPU_SHORT_MEM_RES=8G

# worker-gpu-long: ABFE, RBFE tasks (long-running, concurrency=1 to avoid GPU contention)
WORKER_GPU_LONG_CPU_LIMIT=4
WORKER_GPU_LONG_MEM_LIMIT=48G
WORKER_GPU_LONG_CPU_RES=1
WORKER_GPU_LONG_MEM_RES=16G

# worker-cpu: batch docking (4 parallel Vina jobs by default)
WORKER_CPU_CPU_LIMIT=4
WORKER_CPU_MEM_LIMIT=32G
WORKER_CPU_CPU_RES=1
WORKER_CPU_MEM_RES=8G

# --- Infrastructure ---
POSTGRES_CPU_LIMIT=2
POSTGRES_MEM_LIMIT=4G
POSTGRES_CPU_RES=0.5
POSTGRES_MEM_RES=1G

REDIS_CPU_LIMIT=1
REDIS_MEM_LIMIT=2G
REDIS_CPU_RES=0.25
REDIS_MEM_RES=512M

RABBITMQ_CPU_LIMIT=2
RABBITMQ_MEM_LIMIT=4G
RABBITMQ_CPU_RES=0.5
RABBITMQ_MEM_RES=1G

FLOWER_CPU_LIMIT=1
FLOWER_MEM_LIMIT=1G
FLOWER_CPU_RES=0.25
FLOWER_MEM_RES=256M
